---
import { experience } from "../data/resume";
---

<section class="section" id="experience">
  <div class="container">
    <p class="section-label reveal">// career.log</p>
    <h2 class="section-title reveal">Experience</h2>

    <div class="timeline">
      {experience.map((job, i) => (
        <article
          class="timeline-item reveal reveal-left"
          style={`transition-delay: ${i * 0.1}s`}
        >
          <div class="timeline-marker">
            <span class="timeline-dot"></span>
            {i < experience.length - 1 && <span class="timeline-line"></span>}
          </div>
          <div class="timeline-content card-shine">
            <div class="timeline-header">
              <div>
                <h3 class="timeline-role">{job.role}</h3>
                <p class="timeline-company">{job.company}</p>
              </div>
              <div class="timeline-meta">
                <time class="timeline-period">{job.period}</time>
                <span class="timeline-location">{job.location}</span>
              </div>
            </div>
            <ul class="timeline-highlights">
              {job.highlights.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <div class="timeline-tags">
              {job.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 1.5rem;
  }

  .timeline-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 0.35rem;
  }

  .timeline-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 12px var(--accent-dim);
    flex-shrink: 0;
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s;
  }

  .timeline-item.is-visible .timeline-dot {
    animation: pulse-glow 2.5s ease-in-out infinite;
  }

  .timeline-item:hover .timeline-dot {
    transform: scale(1.3);
  }

  .timeline-line {
    width: 2px;
    flex: 1;
    min-height: 2rem;
    background: linear-gradient(to bottom, var(--accent-dim), var(--border), transparent);
    margin-top: 0.5rem;
  }

  .timeline-content {
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 0.5rem;
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius);
    transition:
      background 0.3s var(--ease-out),
      border-color 0.3s,
      transform 0.3s var(--ease-out);
  }

  .timeline-item:hover .timeline-content {
    background: #151d2e80;
    transform: translateX(4px);
  }

  .timeline-item:last-child .timeline-content {
    border-bottom: none;
    padding-bottom: 0;
  }

  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .timeline-role {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .timeline-company {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--accent);
  }

  .timeline-meta {
    text-align: right;
    flex-shrink: 0;
  }

  .timeline-period {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent-secondary);
    margin-bottom: 0.25rem;
  }

  .timeline-location {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .timeline-highlights {
    list-style: none;
    margin-bottom: 1.25rem;
  }

  .timeline-highlights li {
    position: relative;
    padding-left: 1.25rem;
    margin-bottom: 0.5rem;
    color: var(--text-muted);
    font-size: 0.925rem;
    line-height: 1.6;
  }

  .timeline-highlights li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .timeline-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
</style>
