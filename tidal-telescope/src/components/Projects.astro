---
import { projects, volunteer, education } from "../data/resume";
---

<section class="section" id="projects">
  <div class="container">
    <p class="section-label reveal">// open-source</p>
    <h2 class="section-title reveal">Projects & Community</h2>

    <div class="projects-grid">
      {projects.map((project, i) => (
        <article
          class="project-card reveal card-shine"
          style={`transition-delay: ${i * 0.1}s`}
        >
          <div class="project-header">
            <h3 class="project-name">{project.name}</h3>
            <time class="project-period">{project.period}</time>
          </div>
          <p class="project-desc">{project.description}</p>
          <div class="project-tags">
            {project.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </article>
      ))}
    </div>

    <div class="subsection reveal">
      <h3 class="subsection-title">Education</h3>
      <div class="edu-card card-shine">
        <div>
          <p class="edu-degree">{education.degree}</p>
          <p class="edu-school">{education.school}</p>
        </div>
        <div class="edu-meta">
          <span>{education.period}</span>
          <span>{education.location}</span>
        </div>
      </div>
    </div>

    <div class="subsection reveal">
      <h3 class="subsection-title">Volunteer & Leadership</h3>
      <div class="volunteer-grid">
        {volunteer.map((item, i) => (
          <article
            class="volunteer-card reveal card-shine"
            style={`transition-delay: ${i * 0.08}s`}
          >
            <div class="volunteer-header">
              <h4>{item.role}</h4>
              <time>{item.period}</time>
            </div>
            <p class="volunteer-org">{item.org}</p>
            {item.location && <p class="volunteer-location">{item.location}</p>}
            <p class="volunteer-desc">{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .projects-grid {
    display: grid;
    gap: 1.25rem;
    margin-bottom: 4rem;
  }

  .project-card {
    padding: 1.75rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition:
      border-color 0.3s,
      box-shadow 0.3s,
      transform 0.3s var(--ease-out);
  }

  .project-card:hover {
    border-color: var(--accent-dim);
    box-shadow: 0 0 30px #00ffd508;
    transform: translateY(-4px);
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .project-name {
    font-size: 1.15rem;
    font-weight: 600;
  }

  .project-period {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-secondary);
  }

  .project-desc {
    color: var(--text-muted);
    font-size: 0.925rem;
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .subsection {
    margin-bottom: 3rem;
  }

  .subsection-title {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1.25rem;
  }

  .edu-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    flex-wrap: wrap;
  }

  .edu-degree {
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .edu-school {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .edu-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .volunteer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
  }

  .volunteer-card {
    padding: 1.25rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .volunteer-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.35rem;
    flex-wrap: wrap;
  }

  .volunteer-header h4 {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .volunteer-header time {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--accent-secondary);
  }

  .volunteer-org {
    font-size: 0.85rem;
    color: var(--accent);
    margin-bottom: 0.25rem;
  }

  .volunteer-location {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }

  .volunteer-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
  }
</style>
